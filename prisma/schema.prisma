// =====================================================================
// TechCart - Prisma schema v2 (PostgreSQL)
// Aligned with: BRD, SRS corrections, System Design.
// Rules Prisma cannot express (CHECK constraints, partial unique indexes,
// stock functions, triggers, availability view) live in extras.sql and go
// into the FIRST migration (see setup notes).
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

// ---------- Enums ----------------------------------------------------
enum UserRole {
  customer
  super_admin

  @@map("user_role")
}

enum UserStatus {
  unverified
  verified
  suspended

  @@map("user_status")
}

enum TokenType {
  email_verification
  password_reset

  @@map("token_type")
}

enum PoStatus {
  draft
  ordered
  partially_received
  received
  cancelled

  @@map("po_status")
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  out_for_delivery
  delivered
  cancelled

  @@map("order_status")
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  partially_refunded

  @@map("payment_status")
}

enum ReservationStatus {
  active
  converted
  expired
  cancelled

  @@map("reservation_status")
}

enum ReturnReason {
  shipping_damage
  technical_issue
  manufacturing_defect

  @@map("return_reason")
}

enum ReturnStatus {
  requested
  under_review
  approved
  rejected
  item_received
  inspected
  refunded
  replaced
  closed

  @@map("return_status")
}

enum ReturnResolution {
  refund
  replacement

  @@map("return_resolution")
}

// sale = stock taken for an order item
// replacement = stock taken for a replacement shipment
// restoration = units put back into the SAME batch (cancellation / accepted return)
// damaged = returned units written off (do NOT go back to sellable stock)
enum AllocationType {
  sale
  replacement
  restoration
  damaged

  @@map("allocation_type")
}

enum AdjustmentReason {
  lost
  stolen
  miscount
  damaged
  found

  @@map("adjustment_reason")
}

enum RefundReason {
  cancellation
  return_item
  late_payment

  @@map("refund_reason")
}

// ---------- Users & authentication -----------------------------------
model User {
  id              Int        @id @default(autoincrement())
  name            String
  email           String     @unique // always store lowercase
  phone           String?
  passwordHash    String     @map("password_hash")
  role            UserRole   @default(customer)
  status          UserStatus @default(unverified)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  tokenVersion Int @default(0) @map("token_version") // Increment for account-wide invalidation, such as password change or suspension.
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  authTokens       AuthToken[]
  sessions AuthSession[]
  cart             Cart?
  orders           Order[]            @relation("OrderCustomer")
  cancelledOrders  Order[]            @relation("OrderCancelledBy")
  returnRequests   ReturnRequest[]
  reservations     StockReservation[]
  stockAdjustments StockAdjustment[]
  auditLogs        AuditLog[]

  @@map("users")
}

// Email-verification and password-reset tokens (store only the hash)
model AuthToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      TokenType
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@map("auth_tokens")
}


model AuthSession {
  id                 Int       @id @default(autoincrement())
  userId             Int       @map("user_id")
  tokenVersion Int @map("token_version")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt         DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  absoluteExpiresAt  DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  revocationReason   String?   @map("revocation_reason")
  userAgent          String?   @map("user_agent")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}


model RefreshToken {
  id        Int       @id @default(autoincrement())
  sessionId Int       @map("session_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, usedAt])
  @@map("auth_refresh_tokens")
}



// ---------- Catalog --------------------------------------------------
model Category {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("categories")
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("brands")
}

model Product {
  id             Int       @id @default(autoincrement())
  categoryId     Int       @map("category_id")
  brandId        Int       @map("brand_id")
  name           String
  description    String?
  images         Json      @default("[]") // list of media URLs
  specifications Json      @default("{}")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category         @relation(fields: [categoryId], references: [id])
  brand    Brand            @relation(fields: [brandId], references: [id])
  variants ProductVariant[]

  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model ProductVariant {
  id             Int       @id @default(autoincrement())
  productId      Int       @map("product_id")
  sku            String    @unique
  specifications Json      @default("{}")
  sellingPrice   Decimal   @map("selling_price") @db.Decimal(12, 2)
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product       Product             @relation(fields: [productId], references: [id])
  batches       InventoryBatch[]
  purchaseItems PurchaseOrderItem[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  reservations  StockReservation[]

  @@index([productId])
  @@map("product_variants")
}

// ---------- Suppliers & purchasing -----------------------------------
model Supplier {
  id            Int       @id @default(autoincrement())
  companyName   String    @map("company_name")
  contactPerson String?   @map("contact_person")
  phone         String?
  email         String?
  address       String?
  licenseNumber String?   @map("license_number")
  isActive      Boolean   @default(true) @map("is_active")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  purchaseOrders PurchaseOrder[]
  batches        InventoryBatch[]

  @@map("suppliers")
}

model PurchaseOrder {
  id         Int       @id @default(autoincrement())
  supplierId Int       @map("supplier_id")
  status     PoStatus  @default(draft)
  orderedAt  DateTime? @map("ordered_at") @db.Timestamptz(6)
  receivedAt DateTime? @map("received_at") @db.Timestamptz(6) // when fully received
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
  batches  InventoryBatch[]

  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               Int      @id @default(autoincrement())
  purchaseOrderId  Int      @map("purchase_order_id")
  variantId        Int      @map("variant_id")
  quantity         Int
  receivedQuantity Int      @default(0) @map("received_quantity")
  purchasePrice    Decimal  @map("purchase_price") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  purchaseOrder PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id])
  variant       ProductVariant   @relation(fields: [variantId], references: [id])
  batches       InventoryBatch[]

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// ---------- Inventory (batch level, FIFO) ----------------------------
model InventoryBatch {
  id                  Int      @id @default(autoincrement())
  variantId           Int      @map("variant_id")
  supplierId          Int      @map("supplier_id")
  purchaseOrderId     Int      @map("purchase_order_id")
  purchaseOrderItemId Int      @map("purchase_order_item_id")
  batchReference      String?  @map("batch_reference")
  purchasePrice       Decimal  @map("purchase_price") @db.Decimal(12, 2) // never overwritten
  quantityReceived    Int      @map("quantity_received") // never changes
  quantityRemaining   Int      @map("quantity_remaining")
  receivedAt          DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  variant           ProductVariant        @relation(fields: [variantId], references: [id])
  supplier          Supplier              @relation(fields: [supplierId], references: [id])
  purchaseOrder     PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderItem PurchaseOrderItem     @relation(fields: [purchaseOrderItemId], references: [id])
  allocations       InventoryAllocation[]
  adjustments       StockAdjustment[]

  @@index([variantId])
  @@map("inventory_batches")
}

// ---------- Cart -----------------------------------------------------
model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int      @map("cart_id")
  variantId Int      @map("variant_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ---------- Shipping (flat fee per city, set by the Super Admin) -----
model ShippingRate {
  id        Int      @id @default(autoincrement())
  city      String
  fee       Decimal  @db.Decimal(12, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("shipping_rates")
}

// ---------- Orders ---------------------------------------------------
model Order {
  id                 Int           @id @default(autoincrement())
  userId             Int           @map("user_id")
  status             OrderStatus   @default(pending)
  paymentStatus      PaymentStatus @default(pending) @map("payment_status") // summary, updated with payments in one transaction
  recipientName      String        @map("recipient_name")
  contactNumber      String        @map("contact_number")
  address            String
  city               String
  postalCode         String?       @map("postal_code")
  itemsSubtotal      Decimal       @map("items_subtotal") @db.Decimal(12, 2)
  shippingFee        Decimal       @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  total              Decimal       @db.Decimal(12, 2)
  cancelledById      Int?          @map("cancelled_by") // null = cancelled by the system (expiry)
  cancellationReason String?       @map("cancellation_reason")
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User               @relation("OrderCustomer", fields: [userId], references: [id])
  cancelledBy    User?              @relation("OrderCancelledBy", fields: [cancelledById], references: [id])
  items          OrderItem[]
  payments       Payment[]
  delivery       Delivery?
  returnRequests ReturnRequest[]
  reservations   StockReservation[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int      @map("order_id")
  variantId   Int      @map("variant_id")
  productName String   @map("product_name") // snapshot
  sku         String // snapshot
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2) // snapshot
  quantity    Int
  subtotal    Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order          Order                 @relation(fields: [orderId], references: [id])
  variant        ProductVariant        @relation(fields: [variantId], references: [id])
  allocations    InventoryAllocation[]
  returnRequests ReturnRequest[]

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

// Courier + tracking (entered manually). delivered_at starts the 7-day return window.
// The delivery STATUS is the order status (shipped / out_for_delivery / delivered).
model Delivery {
  id             Int       @id @default(autoincrement())
  orderId        Int       @unique @map("order_id")
  courierName    String?   @map("courier_name")
  trackingNumber String?   @map("tracking_number")
  shippedAt      DateTime? @map("shipped_at") @db.Timestamptz(6)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id])

  @@map("deliveries")
}

// Append-only stock ledger: where every unit came from and where it went back.
model InventoryAllocation {
  id                 Int            @id @default(autoincrement())
  orderItemId        Int?           @map("order_item_id")
  returnRequestId    Int?           @map("return_request_id")
  batchId            Int            @map("batch_id")
  sourceAllocationId Int?           @map("source_allocation_id") // restoration/damaged -> the sale it reverses
  quantity           Int
  allocationType     AllocationType @map("allocation_type")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  orderItem     OrderItem?            @relation(fields: [orderItemId], references: [id])
  returnRequest ReturnRequest?        @relation(fields: [returnRequestId], references: [id])
  batch         InventoryBatch        @relation(fields: [batchId], references: [id])
  source        InventoryAllocation?  @relation("AllocationSource", fields: [sourceAllocationId], references: [id])
  reversals     InventoryAllocation[] @relation("AllocationSource")

  @@index([orderItemId])
  @@index([batchId])
  @@index([sourceAllocationId])
  @@map("inventory_allocations")
}

// Temporary 15-minute stock hold during checkout
model StockReservation {
  id         Int               @id @default(autoincrement())
  userId     Int               @map("user_id")
  orderId    Int               @map("order_id")
  variantId  Int               @map("variant_id")
  quantity   Int
  status     ReservationStatus @default(active)
  reservedAt DateTime          @default(now()) @map("reserved_at") @db.Timestamptz(6)
  expiresAt  DateTime          @map("expires_at") @db.Timestamptz(6)
  releasedAt DateTime?         @map("released_at") @db.Timestamptz(6)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user    User           @relation(fields: [userId], references: [id])
  order   Order          @relation(fields: [orderId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([orderId, variantId])
  @@index([variantId, status])
  @@map("stock_reservations")
}

// ---------- Payments (no card data stored) ---------------------------
model Payment {
  id                   Int           @id @default(autoincrement())
  orderId              Int           @map("order_id")
  gateway              String
  transactionReference String?       @map("transaction_reference")
  amount               Decimal       @db.Decimal(12, 2)
  refundedAmount       Decimal       @default(0) @map("refunded_amount") @db.Decimal(12, 2)
  status               PaymentStatus @default(pending)
  gatewayResponse      Json?         @map("gateway_response")
  paidAt               DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order   Order          @relation(fields: [orderId], references: [id])
  refunds Refund[]
  events  PaymentEvent[]

  @@unique([gateway, transactionReference])
  @@index([orderId])
  @@map("payments")
}

// One row per refund so partial refunds are exact
model Refund {
  id               Int          @id @default(autoincrement())
  paymentId        Int          @map("payment_id")
  returnRequestId  Int?         @map("return_request_id")
  amount           Decimal      @db.Decimal(12, 2)
  reason           RefundReason
  gatewayReference String       @map("gateway_reference") // refund id returned by the gateway; the row is created only AFTER the gateway confirms
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  payment       Payment        @relation(fields: [paymentId], references: [id])
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id])

  @@unique([paymentId, gatewayReference]) // the same gateway refund can never be recorded twice
  @@index([paymentId])
  @@map("refunds")
}

// Every gateway callback is recorded once. The unique (gateway, event_id)
// is what makes duplicate webhooks harmless (idempotency).
model PaymentEvent {
  id          Int       @id @default(autoincrement())
  gateway     String
  eventId     String    @map("event_id")
  paymentId   Int?      @map("payment_id")
  payload     Json
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@unique([gateway, eventId])
  @@map("payment_events")
}

// ---------- Returns --------------------------------------------------
model ReturnRequest {
  id                  Int               @id @default(autoincrement())
  orderId             Int               @map("order_id")
  orderItemId         Int               @map("order_item_id")
  userId              Int               @map("user_id")
  quantity            Int // how many units of the order item are being returned
  reason              ReturnReason
  description         String
  mediaUrls           Json              @default("[]") @map("media_urls")
  status              ReturnStatus      @default(requested)
  requestedResolution ReturnResolution  @default(refund) @map("requested_resolution") // customer's preference
  resolution          ReturnResolution? // admin's final decision
  adminNotes          String?           @map("admin_notes")
  inspectionNotes     String?           @map("inspection_notes")
  inspectionPassed    Boolean?          @map("inspection_passed") // true = back to stock, false = damaged
  requestedAt         DateTime          @default(now()) @map("requested_at") @db.Timestamptz(6)
  approvedAt          DateTime?         @map("approved_at") @db.Timestamptz(6)
  receivedAt          DateTime?         @map("received_at") @db.Timestamptz(6)
  completedAt         DateTime?         @map("completed_at") @db.Timestamptz(6)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  order       Order                 @relation(fields: [orderId], references: [id])
  orderItem   OrderItem             @relation(fields: [orderItemId], references: [id])
  user        User                  @relation(fields: [userId], references: [id])
  allocations InventoryAllocation[]
  refunds     Refund[]

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@map("return_requests")
}

// Manual corrections: lost, stolen, miscount, damaged in store, found
model StockAdjustment {
  id             Int              @id @default(autoincrement())
  batchId        Int              @map("batch_id")
  quantityChange Int              @map("quantity_change")
  reason         AdjustmentReason
  note           String?
  createdById    Int              @map("created_by")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  batch     InventoryBatch @relation(fields: [batchId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])

  @@index([batchId])
  @@map("stock_adjustments")
}

// ---------- Audit trail ----------------------------------------------
model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int?     @map("actor_user_id") // null = system
  entityType  String   @map("entity_type")
  entityId    Int?     @map("entity_id")
  action      String
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
